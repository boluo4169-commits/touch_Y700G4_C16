# ============================================================
# 触控优化模块 - 系统属性配置 (v2.7)
# 针对一加 OPD2413 / Novatek 触控 / ColorOS 16
# 硬件层采样率通过 /proc/HighReportRate 控制（已由 service.sh 写入）
# ============================================================

# --- 游戏触控优化激活 ---
persist.sys.game_touch_optimization=1
persist.sys.oplus_game_touch_adjust=1
persist.vendor.game_touch_optimization=1

# --- 降低游戏场景误触防护（关键：底部边缘掌触抑制） ---
persist.sys.op_mistouch_prevention_gaming=0
persist.vendor.mistouch_prevention_gaming=0

# --- 提升触控事件优先级 ---
persist.sys.touch_priority=1
persist.vendor.touch_priority=1

# --- 关闭边缘抑制（游戏场景） ---
persist.sys.edge_filter_gaming=0
persist.sys.grip_suppression_gaming=0
persist.vendor.edge_suppression=0

# --- 帧率覆写（由 config 控制以降低触控延迟） ---
ro.surface_flinger.game_default_frame_rate_override=144

# --- 输入系统延迟优化 ---
persist.sys.input_latency_reduction=1
persist.vendor.input_latency_mode=1

# --- ColorOS 游戏空间增强 ---
persist.sys.game_mode_touch_boost=1
persist.sys.oplus_game_touch_response=1

# --- SurfaceFlinger 触控定时器归零 ---
ro.surface_flinger.set_touch_timer_ms=0