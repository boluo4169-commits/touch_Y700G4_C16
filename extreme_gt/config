# ============================================================
# Extreme GT Y700G4 — 配置文件
# 修改后重启生效（或重启模块 service）
# ============================================================

# skin_mode: 表面/外壳温区伪装模式
#   follow = 跟随式伪装（默认）：伪装值 = 真实硅温 - skin_offset
#   log    = 干跑：只计算并写入 skin.log，**不写任何节点**（用来先验证取值是否合理）
#   off    = 完全不伪装，恢复系统原始温控反馈（最安全，性能最保守）
skin_mode=follow

# skin_offset: 跟随式偏移量（单位：摄氏度）
#   越大 -> 平时越难触发降频（偏性能）；越小 -> 越早介入降温（偏安全）
#   首档限频阈值是 48C，因此真实硅温超过 (48 + skin_offset) 后开始降频
#   建议区间：12 ~ 25，默认 20（即真实硅温 ~68C 后开始介入）
skin_offset=20

# skin_max: 伪装值硬上限（摄氏度，允许范围 40~70）
#   守护即使全部逻辑失效，也绝不会写出高于此值的伪装温度。
#   61C 对应框架第 5 档阈值，已足以触发降温；留出余量防止被误判为严重过热。
skin_max=61

# skin_min: 伪装值下限（摄氏度，允许范围 20~90）
skin_min=30

# hard_real: 锚点可信域上限（摄氏度）
#   锚点温区读数超过此值即视为**哨兵值/异常**（开机初期部分 TSENS 温区如
#   NSP/CPUSS 会返回 105.0C），该温区本轮弃用，不会据此写值。
hard_real=95
