root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_size = 2

[*.{md,yaml,yml,json,xml}]
indent_size = 2
trim_trailing_whitespace = false

[*.prop]
indent_style = space
indent_size = 0